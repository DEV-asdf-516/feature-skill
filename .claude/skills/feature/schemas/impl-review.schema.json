{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        17
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVE",
        "REQUEST_CHANGES"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "FIX_CODE",
              "DOC_GAP"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "CONTRACT_VIOLATION",
              "UNDECLARED_BEHAVIOR",
              "REACHABLE_BUG",
              "SECURITY_OR_DATA_RISK",
              "REDUNDANT_CONTROL_FLOW",
              "REDUNDANT_CODE",
              "TEST_CONTRACT_GAP",
              "OUT_OF_SCOPE_CHANGE",
              "UNDECIDED_APPROACH"
            ]
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "DIRECT_MISMATCH",
              "REACHABLE_FAILURE",
              "SEMANTIC_REDUNDANCY"
            ]
          },
          "basis_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "code_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reachable_scenario": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "why_blocks_now": {
            "type": "string",
            "minLength": 1
          },
          "required_outcome": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "description": "Round 1 은 ROUND_1 만. Round 2+ 는 UNRESOLVED_PREVIOUS(직전 리뷰의 같은 id 가 미해결) | FIX_REGRESSION(직전 수정이 만든 직접 회귀) | NEWLY_EXPOSED_BY_FIX(직전 수정으로 처음 드러난 문제) 만.",
            "enum": [
              "ROUND_1",
              "UNRESOLVED_PREVIOUS",
              "FIX_REGRESSION",
              "NEWLY_EXPOSED_BY_FIX"
            ]
          },
          "previous_issue_id": {
            "type": "string",
            "description": "origin=UNRESOLVED_PREVIOUS 일 때만 직전 리뷰의 같은 issue id(이 issue 의 id 와 같다). ROUND_1 · FIX_REGRESSION · NEWLY_EXPOSED_BY_FIX 는 빈 문자열."
          },
          "fix_ref": {
            "type": "string",
            "description": "origin=FIX_REGRESSION 또는 NEWLY_EXPOSED_BY_FIX 일 때 필수, ROUND_1 · UNRESOLVED_PREVIOUS 는 빈 문자열. fix_ref = 수정자의 직전 라운드 수정으로 실제 변경된 저장소 상대 소스 파일 경로:L시작-L끝 — fix-diff-round-N.patch 같은 패치 파일 경로가 아니고, 줄 번호는 패치 파일의 행 번호가 아니라 수정 후 소스 파일의 행 번호이며, 그 범위는 수정이 바꾼 hunk 와 겹쳐야 한다(변경이 삭제뿐이면 수정 후 파일에서 삭제 지점에 맞닿은 줄을 가리킨다)"
          },
          "user_question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "action",
          "category",
          "evidence_type",
          "basis_refs",
          "code_refs",
          "reachable_scenario",
          "impact",
          "why_blocks_now",
          "required_outcome",
          "origin",
          "previous_issue_id",
          "fix_ref",
          "user_question",
          "options"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "verdict",
    "issues"
  ],
  "additionalProperties": false
}
